<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The shipped exe is OneNoteMcp.exe (AD-15); namespaces and the project name stay OneNoteMcp.Server. -->
    <AssemblyName>OneNoteMcp</AssemblyName>
    <RootNamespace>OneNoteMcp.Server</RootNamespace>
  </PropertyGroup>
  <!-- Publish only: one self-contained, compressed single-file exe. No trimming or ReadyToRun:
       COM interop and the MCP SDK's reflection are not trim-safe. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- The rolling file log beside stderr (AD-13). -->
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OneNoteMcp.Core\OneNoteMcp.Core.csproj" />
    <!-- Server composes Com (spine diagram); it never uses the interop types, which are internal. -->
    <ProjectReference Include="..\OneNoteMcp.Com\OneNoteMcp.Com.csproj" />
  </ItemGroup>
</Project>
