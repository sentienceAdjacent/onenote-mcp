<Project>
  <PropertyGroup>
    <!-- One number: the release tag (AD-19) and serverInfo.version. Its major.minor is the tool contract version (AD-14). -->
    <Version>0.9.0-rc.1</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Runs the .editorconfig code-style rules in the build; today only the private-field naming rule (IDE1006). -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
